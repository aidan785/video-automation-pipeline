# secrets
.env
*.env.local

# deps
node_modules/

# render + media outputs (regenerate from source)
renders/
**/renders/
raw-media/*
!raw-media/.gitkeep

# large source/intermediate media — never commit multi-GB files
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3
*.m4a
*.aac
# ...but DO keep the small reference transcripts/EDLs that drive the pipeline
!reference/**/*.json

# HyperFrames studio caches + QA/verification artifacts (regenerable)
**/.thumbnails/
**/.waveform-cache/
**/snapshots/
**/assets/**/frames/
**/assets/**/verify/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/

# style-library preview posters (regenerable from cards; keep the dir, not the PNGs)
style-library/*/preview/*
!style-library/*/preview/.gitkeep

# local hyperframes CLI install (Node-25 sharp workaround)
.hf-cli/

# motion-graphics frame-verification output
video-projects/*/snapshots/

# caic-interview-1: generated per-graphic mini-projects (rebuild with _gen.mjs)
video-projects/caic-interview-1/g/

# frame-extraction verification output (regenerable from renders)
video-projects/*/frames/
video-projects/*/.hyperframes/

# debug screenshot output (root _shot-*.mjs scripts)
_shots-*/
_shots-*.png

# misc local junk
*.bak
Screenshot *.png

# third-party ArtCraft "Crafting Apps" under test (binaries, re-downloadable)
craft-apps/

# archives, AE project files and run logs (local only)
*.zip
*.aep
Adobe After Effects Auto-Save/
*.log
__pycache__/
*.pyc
*.bak-*

# cloned third-party repos used as references
video-projects/ais-plus-lead-magnets-2026-09-30-claude/05-visual-assets/repos/
