{
  "$schema": "../registry.schema.json",
  "id": "eisenberg-paper",
  "name": "Eisenberg Paper",
  "number": "10",
  "status": "draft",
  "inspiration": "Greg Isenberg explainer reels (five reference reels frame-analyzed 8/18/26, frames in references/). Tactile paper editorial: software UI printed onto matte cardstock on a warm paper desk, shot top-down with a macro lens. Warm greige canvas with faint graph grid fading at edges, film grain, vignette + gaussian edge defocus. Charcoal terminal windows and pills as physical cards with dual shadows and a 1px top bevel; chunky serif kinetic type stacked with ragged offsets, roman+italic mixed, coral/sage emphasis words; white paper price tags; dashed hand-drawn connectors.",
  "summary": "VERTICAL 1080x1920 (Reels/TikTok) \u2014 deviates from the library 1920x1080 default on purpose. The 'looks like a Greg Isenberg video' style. Use for AI-tool explainers, plugin/product walkthroughs, and founder-brain content where a warm, tactile, editorial look should make software feel physical.",
  "palette": {
    "bg": "#E2DDD6",
    "fg": "#1B1A19",
    "accent": "#DF6B4F",
    "sage": "#93BFA7",
    "mint": "#9FD6B4",
    "tag": "#F6F4F0",
    "paperEdge": "#C9C3BC",
    "lime": "#A8E05F",
    "notes": "Every neutral is warm; no pure black or white. Coral = hot emphasis (type + mascot), sage = calm emphasis, mint = highlighted mono inside dark cards only, lime = icon-sticker accent only (never type). Max one coral + one sage word per screen. Mirrored in tokens.css."
  },
  "fonts": {
    "display": "DM Serif Display",
    "body": "IBM Plex Mono",
    "mono": "IBM Plex Mono",
    "notes": "DM Serif Display (roman+italic MIXED in one phrase, stacked words with ragged offsets) is the only headline voice; Instrument Serif is the approved lighter alternate. IBM Plex Mono is everything printed on a card - uppercase + 0.08em tracking in pills/tags with a '> ' prompt prefix. No sans-serif anywhere."
  },
  "motion": "Physical and never still. A camera wrapper (.ep-cam) pushes the whole scene in ~5% per card with handheld sine drift \u2014 the realism layer. Every element carries a baked 0.3-1deg static rotation. Every element drifts constantly (5px sine float, 2.8-4.2s periods, mulberry32-seeded phases per element). Text builds word by word (stagger ~0.12s, blur(4px)/+10px to sharp). Cards slide up from below frame with motion blur (14px to 0) settling back.out(1.4) in ~0.55s; stickers scale-pop 0.6 to 1 with overshoot. Outgoing elements GHOST - blur to 5px + fade to 20% opacity - never a hard vanish. Dashed connectors draw on via strokeDashoffset. Beats every 1.5-2.5s; cards end on a breathing hold (drift continues).",
  "transitions": "Rack-focus pulls (blur + ghost the outgoing layer while the new one builds) and slide-up-with-motion-blur entrances. No hard cuts, no dissolve-to-black, no whip pans.",
  "texture": "Five mandatory tier1 layers (shared .ep-* classes in tokens.css): paper gradient + 88px graph grid masked at edges, radial-masked backdrop-filter edge defocus (.ep-lens), warm vignette (.ep-vig), seeded SVG-turbulence grain at 5% multiply (.ep-grain). Dual warm shadows (contact + ambient + far spill) on every physical element, 1px top bevel highlight on dark cards. tier2 overlays are transparent: element shadows only.",
