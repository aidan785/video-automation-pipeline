{
  "$schema": "../registry.schema.json",
  "id": "ais-live",
  "name": "AIS LIVE",
  "number": "03",
  "status": "draft",
  "inspiration": "The AIS LIVE event 'command-deck' broadcast look, distilled from the Doors-Open Loop (video-projects/ais-live-loops). Onyx canvas with a receding perspective-grid tunnel (floor + ceiling), a conic light beam, blue + coral glow wells, breathing vignette + film grain, and a persistent AIS/LIVE corner mark with a pulsing red live-dot. Chrome-gradient italic-900 headlines revealed word-by-word; a motion-blur whip + light streak fire on every cut. Reference frames in references/.",
  "summary": "High-energy live-event / broadcast motion graphics. Use for AIS LIVE (and event-style) content — welcomes, hype taglines, big count-up stats, member-win quotes, speaker line-ups, sponsor slates, agendas. The kinetic, depth-driven stage counterpart to Kallaway's calm glass and Vox's paper.",
  "palette": {
    "bg": "#07121C",
    "fg": "#FFFFFF",
    "accent": "#37BDF8",
    "accent2": "#FF8A5C",
    "alert": "#FF3B30",
    "notes": "Onyx canvas (#07121C / deep #040A11), white text, AIS blue hero (chrome/blue gradient headlines + big numbers), coral secondary accent ('Earn Day', punchlines), red used ONLY for the LIVE dot. The AIS/LIVE mark stays SOLID; only headlines get the chrome gradient. Mirrored in tokens.css."
  },
  "fonts": {
    "display": "Montserrat",
    "body": "Inter",
    "mono": "JetBrains Mono",
    "notes": "Montserrat italic-900 is the headline / big-number / mark voice; Inter (300-500, italic sub) is body/captions; JetBrains Mono is eyebrows/kickers/units/timestamps. No serif."
  },
  "motion": "Snappy + kinetic + broadcast. Headlines reveal word-by-word (blur+rise, expo.out); stat numbers pop (back.out) and count up; speaker cards 3D-flip and drift; agenda/track rows slide in from the left; the mark blooms with a blur+brightness pop. The camera never sleeps — a slow continuous dolly, grid scroll, beam rock, glow drift, and breathing vignette run under every card, with a pulsing live-dot. Deterministic (no random / no Date.now).",
  "transitions": "A motion-blur whip + light streak fires on every cut (never a hard cut). Exits whip up + blur, or dolly-through-type on punchlines. Entrances blur-in.",
