{
  "$schema": "../registry.schema.json",
  "id": "vox-explainer",
  "name": "Vox Explainer",
  "number": "01",
  "status": "draft",
  "inspiration": "Vox-style animated documentary / explainer. Paper-collage of old engravings and halftone photos, masked and outlined; high-contrast serif type; one signature yellow shape per beat; hand-drawn arrows; choppy low-shutter stop-motion with camera moves into shallow 3D depth. Reference images in references/.",
  "summary": "Editorial paper-collage explainer. Use for history, research, and idea-driven storytelling where archive imagery and a strong narrative voice carry the piece.",
  "palette": {
    "bg": "#efe9dc",
    "fg": "#17130e",
    "accent": "#ffe01a",
    "red": "#e23b2e",
    "orange": "#f26a1b",
    "notes": "5 symbolic colors: warm paper, warm ink, Vox yellow (the eye-magnet), editorial red, cutout orange. Mirrored in tokens.css."
  },
  "fonts": {
    "display": "Fraunces",
    "body": "Archivo",
    "mono": "Archivo",
    "hand": "Caveat",
    "notes": "Fraunces (300 + 900 italic) is the statement voice; Archivo is metadata; Caveat is handwritten margin notes only."
  },
  "motion": "Choppy / stop-motion. Snap-in with back.out(2.2), shutter feel via steps(), slow camera push on tier1, rack focus for depth.",
  "transitions": "Marker / circle wipes on (scaleX, scale from 0). Quick stepped slides. Never slow symmetric fades.",
  "cards": [
    {
      "id": "vox-explainer.t1.section.circle",
      "tier": "tier1", "purpose": "section", "treatment": "circle",
      "file": "cards/tier1/t1-section-circle.html",
      "slots": [
        { "name": "kicker", "type": "text", "maxChars": 28 },
        { "name": "headline", "type": "richtext", "maxChars": 70, "note": "<em> on one phrase for italic-black emphasis" },
        { "name": "scrap", "type": "image", "note": "cutout archive image; placeholder is a halftone sticker frame" },
        { "name": "note", "type": "text", "maxChars": 18, "note": "handwritten margin note" },
        { "name": "source", "type": "text", "maxChars": 40 }
      ],
      "duration": { "min": 5, "max": 8 },
      "preview": { "mp4": "preview/vox-explainer.t1.section.circle.mp4", "poster": "preview/vox-explainer.t1.section.circle.png" }
    },
